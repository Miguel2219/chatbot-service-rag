# ── Required ─────────────────────────────────────────
OPENAI_API_KEY=
INTERNAL_API_KEY=
CHROMA_HOST=

# ── Cloudflare R2 ────────────────────────────────────
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Must match the bucket configured in the platform backend
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ── Models ───────────────────────────────────────────
MODEL_NAME=gpt-4.1-mini
VISION_MODEL_NAME=gpt-4o
OPENAI_LLM_TIMEOUT_SECONDS=30.0
OPENAI_VISION_TIMEOUT_SECONDS=45.0
OPENAI_MAX_RETRIES=3

# ── ChromaDB ─────────────────────────────────────────
CHROMA_PORT=8000

# ── Sessions ─────────────────────────────────────────
CHAT_HISTORY_MAX_TURNS=20
SESSION_TTL_SECONDS=86400
SESSION_MAX_COUNT=2000
SESSION_CLEANUP_INTERVAL_SECONDS=300

# ── Rate limiting ────────────────────────────────────
RATE_LIMIT_CHAT_PER_IP=60/minute
RATE_LIMIT_CHAT_PER_BOT=30/minute
RATE_LIMIT_PROCESS_PER_IP=20/minute